{"name": "方言校箋", "cat": "小学", "size": 88662, "count": 36, "chapters": [{"title": "方言校笺", "anchor": "c0", "summary": "", "concepts": []}, {"title": "輶轩使者绝代语释别国方言第二", "anchor": "c3145", "summary": "", "concepts": []}, {"title": "輶轩使者绝代语释别国方言第三", "anchor": "c5727", "summary": "", "concepts": []}, {"title": "堇葇也，亦苏之种类，因名云。）", "anchor": "c6378", "summary": "", "concepts": []}, {"title": "氓，民也。（民之总名。音萌。）", "anchor": "c7422", "summary": "", "concepts": []}, {"title": "铦，取也。（谓挑取物。音忝。）", "anchor": "c7650", "summary": "", "concepts": []}, {"title": "輶轩使者绝代语释别国方言第四", "anchor": "c8194", "summary": "", "concepts": []}, {"title": "褛谓之致。（褴褛缀结也。）", "anchor": "c8757", "summary": "", "concepts": []}, {"title": "絜襦谓之蔽膝。（广异名也。）", "anchor": "c9075", "summary": "", "concepts": []}, {"title": "纑谓之缜。（谓纑缕也。音振。）", "anchor": "c9855", "summary": "", "concepts": []}, {"title": "罃谓之□。（鼓鼙。）", "anchor": "c10767", "summary": "", "concepts": []}, {"title": "輶轩使者绝代语释别国方言第六", "anchor": "c12506", "summary": "", "concepts": []}, {"title": "猒，塞，安也。（物足则安。）", "anchor": "c14756", "summary": "", "concepts": []}, {"title": "过度谓之涉济。（犹今云济度。）", "anchor": "c16242", "summary": "", "concepts": []}, {"title": "輶轩使者绝代语释别国方言第九", "anchor": "c17740", "summary": "", "concepts": []}, {"title": "钻谓之□。（音端。）", "anchor": "c18049", "summary": "", "concepts": []}, {"title": "輑谓之轴。（牛忿反。）", "anchor": "c18400", "summary": "", "concepts": []}, {"title": "犍牛。）或谓之□。（牛犊。）", "anchor": "c18797", "summary": "", "concepts": []}, {"title": "輶轩使者绝代语释别国方言第十", "anchor": "c19366", "summary": "", "concepts": []}, {"title": "輶轩使者绝代语释别国方言第十一", "anchor": "c22037", "summary": "", "concepts": []}, {"title": "輶轩使者绝代语释别国方言第十二", "anchor": "c23537", "summary": "", "concepts": []}, {"title": "解，输，梲也。（梲犹脱耳。）", "anchor": "c23861", "summary": "", "concepts": []}, {"title": "佻，疾也。（谓轻疾也。音粜。）", "anchor": "c24217", "summary": "", "concepts": []}, {"title": "倩，荼，借也。（荼犹徒也。）", "anchor": "c24455", "summary": "", "concepts": []}, {"title": "羞，厉，熟也。（熟食为羞。）", "anchor": "c24774", "summary": "", "concepts": []}, {"title": "□，幕也。（谓蒙幕也。音医。）", "anchor": "c25352", "summary": "", "concepts": []}, {"title": "蒇，敕，戒备也。（蒇亦训敕。）", "anchor": "c25729", "summary": "", "concepts": []}, {"title": "谴喘，转也。（谴喘犹宛转也。）", "anchor": "c26106", "summary": "", "concepts": []}, {"title": "宛，蓄也。（谓宛乐也。言婉。）", "anchor": "c26316", "summary": "", "concepts": []}, {"title": "扲，业也。（谓基业也。音钳。）", "anchor": "c26556", "summary": "", "concepts": []}, {"title": "翳，掩也。（谓掩覆也。）", "anchor": "c26777", "summary": "", "concepts": []}, {"title": "易，始也。（易代更始也。）", "anchor": "c26992", "summary": "", "concepts": []}, {"title": "迒，迹也。（尔雅以为兔迹。）", "anchor": "c27202", "summary": "", "concepts": []}, {"title": "梗，略也。（梗概大略也。）", "anchor": "c27409", "summary": "", "concepts": []}, {"title": "澌，索也。（尽也。）", "anchor": "c27646", "summary": "", "concepts": []}, {"title": "锥谓之鍣。（广雅作鉊字。）", "anchor": "c27922", "summary": "", "concepts": []}], "source": "auto"}